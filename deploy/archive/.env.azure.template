# Azure Deployment Configuration Template
# Copy to .env.azure and fill in your values

# ============================================
# Azure Subscription & Authentication
# ============================================
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=axon-aone-rg
AZURE_LOCATION=eastus
AZURE_ENVIRONMENT=AzureCloud

# ============================================
# Container Registry Configuration
# ============================================
REGISTRY_NAME=axonaoneacr
REGISTRY_URL=axonaoneacr.azurecr.io
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
IMAGE_NAME=axon-aone
IMAGE_TAG=latest

# ============================================
# Container Instance Configuration
# ============================================
CONTAINER_GROUP_NAME=axon-aone-aci
CONTAINER_NAME=axon-aone
CONTAINER_CPU=1
CONTAINER_MEMORY=2
CONTAINER_PORT=8080
RESTART_POLICY=Always

# ============================================
# Angel One Broker Configuration
# ============================================
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_PIN=
ANGEL_ONE_TOTP_SECRET=

# ============================================
# Application Configuration
# ============================================
MOCK_MODE=false
TZ=Asia/Kolkata
PYTHON_ENVIRONMENT=production
LOG_LEVEL=INFO
MARKET_HOURS_START=09:15
MARKET_HOURS_END=15:30
WEEKEND_TRADING=false

# ============================================
# Application Insights & Monitoring
# ============================================
APPINSIGHTS_INSTRUMENTATIONKEY=
APPINSIGHTS_ENABLED=true
LOG_ANALYTICS_WORKSPACE_ID=
LOG_ANALYTICS_WORKSPACE_KEY=

# ============================================
# Key Vault Configuration
# ============================================
KEYVAULT_NAME=axon-aone-kv
KEYVAULT_URI=
KEYVAULT_ENABLED=false

# ============================================
# Azure SQL Database (if using)
# ============================================
SQL_SERVER_NAME=
SQL_DATABASE_NAME=axon_aone_db
SQL_USERNAME=
SQL_PASSWORD=
SQL_DRIVER={ODBC Driver 17 for SQL Server}

# ============================================
# Azure Storage (for logs and backups)
# ============================================
STORAGE_ACCOUNT_NAME=
STORAGE_ACCOUNT_KEY=
STORAGE_CONTAINER_LOGS=logs
STORAGE_CONTAINER_BACKUPS=backups
STORAGE_ENABLE=false

# ============================================
# Azure App Service (if deploying to App Service)
# ============================================
APP_SERVICE_PLAN_NAME=axon-aone-plan
APP_SERVICE_NAME=axon-aone-app
APP_SERVICE_SKU=B2

# ============================================
# Azure Kubernetes Service (if deploying to AKS)
# ============================================
AKS_CLUSTER_NAME=axon-aone-aks
AKS_NODE_COUNT=2
AKS_VM_SIZE=Standard_B2s
AKS_KUBERNETES_VERSION=1.27

# ============================================
# CI/CD & GitHub Actions
# ============================================
GITHUB_REPOSITORY=your-username/axon-aone
GITHUB_BRANCH=main
GITHUB_DEPLOY_ON_PUSH=true

# ============================================
# Email & Notifications
# ============================================
SENDGRID_API_KEY=
NOTIFICATION_EMAIL=admin@example.com
SLACK_WEBHOOK_URL=

# ============================================
# Tags & Cost Management
# ============================================
RESOURCE_TAGS_ENVIRONMENT=production
RESOURCE_TAGS_PROJECT=axon-aone
RESOURCE_TAGS_OWNER=your-team
RESOURCE_TAGS_COST_CENTER=trading

# ============================================
# Advanced Configuration
# ============================================
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5
REQUEST_TIMEOUT_SECONDS=30
HEALTH_CHECK_INTERVAL=30
ENABLE_DEBUG_MODE=false
