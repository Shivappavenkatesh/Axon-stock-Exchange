{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "projectName": {
      "type": "string",
      "defaultValue": "axon-aone",
      "metadata": {
        "description": "Name of the project"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "containerImage": {
      "type": "string",
      "metadata": {
        "description": "Container image URI (e.g., myregistry.azurecr.io/axon-aone:latest)"
      }
    },
    "registryUsername": {
      "type": "string",
      "metadata": {
        "description": "Registry username"
      }
    },
    "registryPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Registry password"
      }
    },
    "angelOneApiKey": {
      "type": "securestring",
      "metadata": {
        "description": "Angel One API Key"
      }
    },
    "angelOneClientId": {
      "type": "securestring",
      "metadata": {
        "description": "Angel One Client ID (User ID)"
      }
    },
    "angelOnePin": {
      "type": "securestring",
      "metadata": {
        "description": "Angel One 4-digit MPIN"
      }
    },
    "angelOneTotpSecret": {
      "type": "securestring",
      "metadata": {
        "description": "Angel One TOTP Secret (Base32)"
      }
    },
    "mockMode": {
      "type": "string",
      "defaultValue": "false",
      "allowedValues": [
        "true",
        "false"
      ],
      "metadata": {
        "description": "Enable mock trading mode"
      }
    },
    "containerCpu": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "CPU cores for container (0.5 - 4)"
      }
    },
    "containerMemory": {
      "type": "string",
      "defaultValue": "2",
      "metadata": {
        "description": "Memory in GB for container (1 - 4)"
      }
    },
    "restartPolicy": {
      "type": "string",
      "defaultValue": "Always",
      "allowedValues": [
        "Always",
        "OnFailure",
        "Never"
      ],
      "metadata": {
        "description": "Container restart policy"
      }
    }
  },
  "variables": {
    "containerGroupName": "[concat(parameters('projectName'), '-aci')]",
    "containerName": "[parameters('projectName')]"
  },
  "resources": [
    {
      "type": "Microsoft.ContainerInstance/containerGroups",
      "apiVersion": "2021-09-01",
      "name": "[variables('containerGroupName')]",
      "location": "[parameters('location')]",
      "properties": {
        "containers": [
          {
            "name": "[variables('containerName')]",
            "properties": {
              "image": "[parameters('containerImage')]",
              "resources": {
                "requests": {
                  "cpu": "[parameters('containerCpu')]",
                  "memoryInGb": "[float(parameters('containerMemory'))]"
                }
              },
              "environmentVariables": [
                {
                  "name": "ANGEL_ONE_API_KEY",
                  "secureValue": "[parameters('angelOneApiKey')]"
                },
                {
                  "name": "ANGEL_ONE_CLIENT_ID",
                  "secureValue": "[parameters('angelOneClientId')]"
                },
                {
                  "name": "ANGEL_ONE_PIN",
                  "secureValue": "[parameters('angelOnePin')]"
                },
                {
                  "name": "ANGEL_ONE_TOTP_SECRET",
                  "secureValue": "[parameters('angelOneTotpSecret')]"
                },
                {
                  "name": "MOCK_MODE",
                  "value": "[parameters('mockMode')]"
                },
                {
                  "name": "TZ",
                  "value": "Asia/Kolkata"
                },
                {
                  "name": "PYTHONUNBUFFERED",
                  "value": "1"
                }
              ],
              "command": [
                "python",
                "run_trader.py",
                "--schedule"
              ],
              "volumeMounts": [
                {
                  "name": "logsvolume",
                  "mountPath": "/app/logs"
                }
              ]
            }
          }
        ],
        "osType": "Linux",
        "restartPolicy": "[parameters('restartPolicy')]",
        "imageRegistryCredentials": [
          {
            "server": "[substring(parameters('containerImage'), 0, indexOf(parameters('containerImage'), '/'))]",
            "username": "[parameters('registryUsername')]",
            "password": "[parameters('registryPassword')]"
          }
        ],
        "volumes": [
          {
            "name": "logsvolume",
            "emptyDir": {}
          }
        ]
      }
    }
  ],
  "outputs": {
    "containerGroupId": {
      "type": "string",
      "value": "[resourceId('Microsoft.ContainerInstance/containerGroups', variables('containerGroupName'))]"
    },
    "containerGroupName": {
      "type": "string",
      "value": "[variables('containerGroupName')]"
    }
  }
}
