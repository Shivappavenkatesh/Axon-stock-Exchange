# Axon Aone - Angel One Smart API Environment Configuration
# Copy this file to .env and fill in your credentials

# ========================
# USER 1 CONFIGURATION
# ========================

# Angel One Credentials (User 1)
# Get API Key from: https://smartapi.angelbroking.com/
USER1_ANGEL_ONE_API_KEY=your_api_key
# Your Angel One User ID (e.g., A123456)
USER1_ANGEL_ONE_CLIENT_ID=your_client_id
# Your 4-digit trading MPIN
USER1_ANGEL_ONE_PIN=your_pin
# TOTP secret from Angel One App > Profile > Settings > TOTP
# Must be base32 format (e.g., YOUR_BASE32_TOTP_SECRET)
USER1_ANGEL_ONE_TOTP_SECRET=your_totp_secret

# Mock/Paper Trading Mode (User 1)
# Set to 'true' for mock trading, 'false' for live trading
USER1_MOCK_MODE=false

# ========================
# USER 2 CONFIGURATION
# ========================

# Angel One Credentials (User 2)
USER2_ANGEL_ONE_API_KEY=your_api_key
USER2_ANGEL_ONE_CLIENT_ID=your_client_id
USER2_ANGEL_ONE_PIN=your_pin
USER2_ANGEL_ONE_TOTP_SECRET=your_totp_secret

# Mock/Paper Trading Mode (User 2)
USER2_MOCK_MODE=false

# ========================
# STRATEGY PROFILE (GLOBAL)
# ========================
# Optional preset profile. Use "blended_titan_mode" for a balanced
# quality + asymmetry + risk-first configuration.
AXON_STRATEGY_PROFILE=default

# Optional explicit overrides (leave blank to use profile defaults)
AXON_PER_TRADE_RISK_PCT=
AXON_DAILY_LOSS_LIMIT_PCT=
AXON_WEEKLY_LOSS_LIMIT_PCT=
AXON_MAX_POSITION_PCT=
AXON_MAX_CONCURRENT_POSITIONS=
AXON_MAX_NEW_ENTRIES_PER_CYCLE=
AXON_MAX_CORRELATED_POSITIONS=
AXON_CORRELATION_BLOCK_THRESHOLD=
AXON_LEARNING_MIN_CLOSED_TRADES=
AXON_EXECUTION_MAX_SLIPPAGE_PCT=
AXON_VAR_DAILY_95_PCT=
AXON_STRESS_SCENARIO_LOSS_PCT=
AXON_MAX_SECTOR_PCT=
AXON_MAX_NEW_EXPOSURE_PCT=
AXON_MODEL_PROMOTION_MIN_PAPER_DAYS=
AXON_MODEL_PROMOTION_MIN_SHARPE=
AXON_MODEL_PROMOTION_MIN_WIN_RATE=
AXON_MODEL_PROMOTION_MAX_DRAWDOWN_PCT=
AXON_RISK_COMMITTEE_REPORT_DIR=

# Symbol selection controls
# 0 means adaptive threshold-only selection (no fixed stock count cap)
AXON_AUTO_SELECT_TOP_N=
AXON_SYMBOL_SELECTION_MIN_SCORE=
AXON_SYMBOL_SELECTION_RELATIVE_TO_BEST=

# Exit and profit-protection controls
AXON_FIXED_PROFIT_TARGET_PCT=
AXON_PROFIT_PROTECT_ACTIVATION_PCT=
AXON_PROFIT_PROTECT_DROP_PCT=
