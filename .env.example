# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Angel One (one API key for Axon's orders) ---
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_PIN=
ANGEL_ONE_TOTP_SECRET=

# --- SEBI retail algo compliance ---
# Public IP registered with Angel One. Live orders are refused from any other IP.
AXON_STATIC_IP=
# Algo ID issued through Angel One; sent as the order tag (max 20 characters)
AXON_ALGO_ID=

# --- Dashboard login (required; the web app will not start without it) ---
AXON_WEB_USERNAME=
# Create with: python -m axon hash-password
AXON_WEB_PASSWORD_HASH=
# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
AXON_WEB_SECRET_KEY=
# Listens on this machine only. Reach it with: ssh -L 8080:127.0.0.1:8080 user@server
AXON_WEB_HOST=127.0.0.1
AXON_WEB_PORT=8080
# Set to true only when the dashboard is served over HTTPS
AXON_WEB_HTTPS=false

# --- Telegram alerts (private chat) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage ---
AXON_DB_PATH=data/axon.sqlite3
AXON_REPORTS_DIR=reports

# --- Rules (defaults follow the spec; brake levels and order rate can only be made stricter) ---
# AXON_INTRADAY_RISK_PCT=0.25
# AXON_INTRADAY_MAX_VIX=20
# AXON_SLIPPAGE_PCT=0.05
# AXON_TAX_INTRADAY_PCT=30
# AXON_MAX_ORDERS_PER_SECOND=2
# AXON_ONE_POSITION_ACROSS_PARTS=true
# AXON_RESTRICTED_SYMBOLS=SYMBOL1-EQ,SYMBOL2-EQ
# AXON_TIER_A_MIN=500000000
# AXON_TIER_B_MIN=50000000
# AXON_TIER_C_MIN=5000000
